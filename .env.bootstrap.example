# Privileged Cloudflare credentials for minting the deploy token only.
# Mount a 1Password Environments local .env at .env.bootstrap (FIFO), or copy
# this file to .env.bootstrap. Never commit it.
#
# NEVER copy CLOUDFLARE_BOOTSTRAP_API_TOKEN into GitHub secrets or .env.
# Account API token with Account → Account API Tokens → Edit.

CLOUDFLARE_BOOTSTRAP_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
