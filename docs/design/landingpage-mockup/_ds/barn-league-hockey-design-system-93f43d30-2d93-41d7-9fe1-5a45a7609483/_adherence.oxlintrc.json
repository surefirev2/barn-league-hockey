{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/display/**",
              "components/forms/**",
              "ui_kits/forms/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Anton|Oswald|Barlow|Barlow Condensed))/i]",
        "message": "Font not provided by the design system. Available: Anton, Oswald, Barlow, Barlow Condensed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:red|dark|bone|outline|ok|pending)$/]",
        "message": "<Badge> tone must be one of 'red' | 'dark' | 'bone' | 'outline' | 'ok' | 'pending'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrushBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|as|key|ref|className|style|children)$/]",
        "message": "<BrushBanner> doesn't accept that prop. Declared props: tone, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrushBanner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:red|dark|bone)$/]",
        "message": "<BrushBanner> tone must be one of 'red' | 'dark' | 'bone'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|onDark|as|iconBefore|iconAfter|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, onDark, as, iconBefore, iconAfter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|eyebrow|title|interactive|as|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, eyebrow, title, interactive, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|plate|paper|dark)$/]",
        "message": "<Card> variant must be one of 'default' | 'plate' | 'paper' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|onDark|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, onDark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checklist'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|onDark|className|key|ref|className|style|children)$/]",
        "message": "<Checklist> doesn't accept that prop. Declared props: items, onDark, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|required|help|error|htmlFor|inline|className|children|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, required, help, error, htmlFor, inline, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|icon|tone|className|children|key|ref|className|style|children)$/]",
        "message": "<FormSection> doesn't accept that prop. Declared props: title, icon, tone, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormSection'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:red|dark)$/]",
        "message": "<FormSection> tone must be one of 'red' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|label|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|shape|size|onDark|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, shape, size, onDark."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline|ghost)$/]",
        "message": "<IconButton> variant must be one of 'solid' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:circle|square)$/]",
        "message": "<IconButton> shape must be one of 'circle' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:invalid|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: invalid."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|height|scrim|align|key|ref|className|style|children)$/]",
        "message": "<PhotoBand> doesn't accept that prop. Declared props: src, alt, height, scrim, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoBand'] > JSXAttribute[name.name='scrim'] > Literal[value!=/^(?:bottom|side|flat)$/]",
        "message": "<PhotoBand> scrim must be one of 'bottom' | 'side' | 'flat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoBand'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<PhotoBand> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<RadioOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|sub|align|onDark|rule|className|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: eyebrow, title, sub, align, onDark, rule, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeader> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StarRule'] > JSXAttribute > JSXIdentifier[name!=/^(?:onDark|className|key|ref|className|style|children)$/]",
        "message": "<StarRule> doesn't accept that prop. Declared props: onDark, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatRailItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|eyebrow|headline|note|key|ref|className|style|children)$/]",
        "message": "<StatRailItem> doesn't accept that prop. Declared props: icon, eyebrow, headline, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:dot|filled|onDark|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: dot, filled, onDark."
      },
      {
        "selector": "JSXOpeningElement[name.name='TeamCrest'] > JSXAttribute > JSXIdentifier[name!=/^(?:team|logo|name|meta|interactive|key|ref|className|style|children)$/]",
        "message": "<TeamCrest> doesn't accept that prop. Declared props: team, logo, name, meta, interactive."
      },
      {
        "selector": "JSXOpeningElement[name.name='TeamCrest'] > JSXAttribute[name.name='team'] > Literal[value!=/^(?:shockers|hornets|rockets)$/]",
        "message": "<TeamCrest> team must be one of 'shockers' | 'hornets' | 'rockets'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:invalid|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: invalid."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
