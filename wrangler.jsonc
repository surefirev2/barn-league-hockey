{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barn-league-hockey",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "routes": [
    {
      "pattern": "barnleaguehockey.ca",
      "custom_domain": true,
    },
  ],
  "vars": {
    "SEASON_ID": "2026-27",
    "REGISTRATION_NOTIFY_EMAIL": "chutchic@gmail.com",
    "REGISTRATION_FROM_EMAIL": "registrations@barnleaguehockey.ca",
    "TURNSTILE_SITE_KEY": "",
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["registrations@barnleaguehockey.ca"],
      "allowed_destination_addresses": ["chutchic@gmail.com"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "barn-league-hockey",
      "database_id": "68c7a757-60fb-46ac-807f-d02657a86dcc",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "REGISTRATION_PDFS",
      "bucket_name": "barn-league-hockey-registrations",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "REGISTRATION_EXPORT",
        "queue": "registration-export",
      },
    ],
    "consumers": [
      {
        "queue": "registration-export",
        "max_batch_size": 1,
        "max_retries": 8,
      },
    ],
  },
}
