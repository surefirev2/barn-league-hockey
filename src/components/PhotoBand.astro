---
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt?: string;
  objectPosition?: string;
  scrim?: "bottom" | "full" | "flat";
  size?: "short" | "story";
}

const {
  image,
  alt = "",
  objectPosition = "center",
  scrim = "bottom",
  size = "short",
} = Astro.props;

const scrimClass =
  scrim === "full"
    ? "bl-photoband__scrim bl-photoband__scrim--side"
    : scrim === "flat"
      ? "bl-photoband__scrim bl-photoband__scrim--flat"
      : "bl-photoband__scrim";

const sizeClass =
  size === "story" ? "photo-band photo-band--story" : "photo-band";
---

<div class:list={["bl-photoband", "bl-grain", sizeClass]}>
  <img
    class="bl-photoband__img"
    src={image.src}
    alt={alt}
    width={image.width}
    height={image.height}
    style={`object-position: ${objectPosition}`}
  />
  <div class={scrimClass}></div>
  <div class="bl-photoband__content">
    <slot />
  </div>
</div>
