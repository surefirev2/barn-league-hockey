---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import SeasonFacts from "../components/SeasonFacts.astro";
import PhotoBand from "../components/PhotoBand.astro";
import WhatToExpect from "../components/WhatToExpect.astro";
import Teams from "../components/Teams.astro";
import RegisterTeaser from "../components/RegisterTeaser.astro";
import BrushBanner from "../components/BrushBanner.astro";
import SiteFooter from "../components/SiteFooter.astro";
import StickyRegister from "../components/StickyRegister.astro";
import PlayerRegistrationForm from "../components/PlayerRegistrationForm.astro";
import photoBenchLaughs from "../assets/photo-bench-laughs.png";
import photoHandshake from "../assets/photo-handshake.png";
import { landing } from "../content/landing";
---

<BaseLayout title="Barn League Hockey">
  <SiteHeader />
  <main>
    <Hero />
    <SeasonFacts />
    <PhotoBand
      image={photoBenchLaughs}
      alt="Players laughing on the bench between shifts"
      objectPosition="center 30%"
      size="story"
    >
      <p class="photo-band__kicker">{landing.bands.arena}</p>
      <p class="photo-band__quote">
        {landing.storiesBefore}<span class="photo-band__quote-accent"
          >{landing.storiesAccent}</span
        >{landing.storiesAfter}
      </p>
    </PhotoBand>
    <WhatToExpect />
    <PhotoBand
      image={photoHandshake}
      alt="Players shaking hands after a game"
      objectPosition="center"
    >
      <p class="photo-band__quote">{landing.bands.handshake}</p>
    </PhotoBand>
    <Teams />
    <RegisterTeaser />
    <BrushBanner />
  </main>
  <SiteFooter />
  <StickyRegister />
  <PlayerRegistrationForm />
</BaseLayout>

<script src="../scripts/team-preference-ui.ts"></script>
<script src="../scripts/registration-form.ts"></script>
