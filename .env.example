# Cloudflare deploy credentials for GitHub Actions and local wrangler.
# Copy to .env and fill in. Never commit .env.
#
# Least-privilege token (Workers Scripts Write + Account Settings Read on this
# account, Workers Routes Write on zone barnleaguehockey.ca only). Fill
# .env.bootstrap then run `make tokens/mint` — it writes these two keys. Never
# put the bootstrap token in GitHub secrets.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional Astro public Turnstile site key (widget). The Worker reads
# TURNSTILE_SITE_KEY / TURNSTILE_SECRET_KEY from wrangler vars/secrets.
PUBLIC_TURNSTILE_SITE_KEY=
